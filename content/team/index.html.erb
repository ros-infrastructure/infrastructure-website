---
title: Our team
---
<div class="container">
  <div class="page-head">
    <span class="eyebrow">Project management committee</span>
    <h1>Our team</h1>
  </div>
  <div class="card-grid">
    <% @items.find_all('/team/*.md').each do |member| %>
      <article class="card">
        <a class="card-link" href="<%= @config[:base_url] %><%= member.identifier.without_ext %>">
          <%= parse_markdown_link member[:picture], :image, "team-card__img", @config[:base_url] %>
          <div class="card__body">
            <h3 class="team-card__name"><%= member[:name] %></h3>
            <span class="role">PMC <%= member[:role] %></span>
            <p class="meta-line"><span class="meta-line__label">Username:</span> <%= member[:username] %></p>
            <p class="meta-line"><span class="meta-line__label">Affiliation:</span> <%= parse_markdown_link member[:affiliation], :text %></p>
          </div>
        </a>
      </article>
    <% end %>
  </div>
</div>
