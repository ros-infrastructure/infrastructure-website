<span class="section-label">Project management committee</span>
<h1 class="page-title">Our team</h1>
<div class="profile-grid">
  <% @items.find_all('/team/*.md').each do |member| %>
    <a class="profile-card" href="<%= @config[:base_url] %><%= member.identifier.without_ext %>">
      <%= parse_markdown_link member[:picture], :image, "profile-card__img", @config[:base_url] %>
      <div class="profile-card__body">
        <p class="profile-card__name"><%= member[:name] %></p>
        <p class="profile-card__role">PMC <%= member[:role] %></p>
        <p class="profile-card__meta"><b>Username:</b> <%= member[:username] %></p>
        <p class="profile-card__meta"><b>Affiliation:</b> <%= /\[(.*)\]/.match(member[:affiliation])[1] %></p>
      </div>
    </a>
  <% end %>
</div>
