---
title: Managed repositories
---
<% repos = @items.find_all('/repos/*.md') %>
<div class="container">
  <div class="page-head">
    <span class="eyebrow">Version control</span>
    <h1>Managed repositories <span class="page-head__count">(<%= repos.size %>)</span></h1>
  </div>
  <div class="row-list">
    <% repos.each do |repo| %>
      <%= repo.reps.find { |r| r.name == :default }.compiled_content(snapshot: :last) %>
    <% end %>
  </div>
</div>
