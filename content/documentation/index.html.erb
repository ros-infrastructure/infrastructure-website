---
title: Documentation
---
<div class="container">
  <div class="page-head">
    <span class="eyebrow">Reference</span>
    <h1>Check the documentation</h1>
  </div>
  <div class="row-list" style="max-width: 46rem;">
    <% @items.find_all('/projects/*.md').each do |project| %>
      <% if project[:docs_url] %>
        <a class="row-list__item" href="<%= project[:docs_url] %>" target="_blank" rel="noopener noreferrer">
          <span class="row-list__main row-list__title"><%= project[:title] %> documentation</span>
          <svg class="row-list__arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9h12M10 4l5 5-5 5"/>
          </svg>
        </a>
      <% end %>
    <% end %>
  </div>
</div>
