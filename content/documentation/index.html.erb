<span class="section-label">Reference</span>
<h1 class="page-title">Check the documentation</h1>
<div class="doc-list">
  <% @items.find_all('/projects/*.md').each do |project| %>
    <% if project[:docs_url] %>
      <a href="<%= project[:docs_url] %>">
        <%= project[:title] %> documentation
      </a>
    <% end %>
  <% end %>
</div>
