<div class="hero">
  <div class="hero-eyebrow">OSRA · Infrastructure Project</div>
  <h1 class="hero-title"><%= @item[:title] %></h1>
  <div class="hero-lede">
    <%= yield %>
  </div>
</div>

<div class="section">
  <h2 class="section-label">Managed by this project</h2>
  <h2 class="section-title">Projects</h2>
  <div class="card-grid">
    <% @items.find_all('/projects/*.md').each do |project| %>
      <a class="node-card" href="<%= @config[:base_url] %><%= project.identifier.without_ext %>">
        <div class="node-card__head">
          <img class="node-card__logo" src="<%= @config[:base_url] %>/images/<%= project[:logo] %>" alt="<%= project[:title] %> logo">
          <div>
            <div class="node-card__title"><%= project[:title] %></div>
            <span class="node-card__tag">[ active ]</span>
          </div>
        </div>
        <p class="node-card__desc"><%= project[:description] %></p>
      </a>
    <% end %>
  </div>
</div>
