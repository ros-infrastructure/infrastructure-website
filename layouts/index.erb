<section class="hero">
  <div class="container">
    <div class="hero__body">
      <span class="badge-pill">OSRA &middot; Infrastructure Project</span>
      <h1><%= @item[:title] %></h1>
      <div class="prose"><%= yield %></div>
    </div>
  </div>
</section>

<section class="container" style="padding-top: 4rem;">
  <div class="page-head">
    <span class="eyebrow">Managed by this project</span>
    <h2>Projects</h2>
  </div>
  <div class="card-grid">
    <% @items.find_all('/projects/*.md').each do |project| %>
      <%= render '/project_card.erb', project: project %>
    <% end %>
  </div>
</section>
