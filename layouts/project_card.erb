<article class="card">
  <a class="card-link card__body" href="<%= @config[:base_url] %><%= project.identifier.without_ext %>">
    <div class="card__head">
      <img class="card__logo" src="<%= @config[:base_url] %>/images/<%= project[:logo] %>" alt="">
      <div>
        <h3 class="card__title"><%= project[:title] %></h3>
        <span class="tag">[ active ]</span>
      </div>
    </div>
    <p class="card__text"><%= project[:description] %></p>
  </a>
</article>
