<div class="container detail">
  <div class="detail__head">
    <%= parse_markdown_link @item[:picture], :image, "detail__portrait", @config[:base_url] %>
    <div>
      <span class="eyebrow">Project management committee</span>
      <h1><%= @item[:name] %></h1>
      <span class="role">PMC <%= @item[:role] %></span>
    </div>
  </div>

  <div class="prose"><%= yield %></div>

  <dl class="facts">
    <dt>Affiliation</dt>
    <dd><%= parse_markdown_link @item[:affiliation], :link %></dd>

    <dt>Username</dt>
    <dd><%= @item[:username] %></dd>

    <dt>Timezone</dt>
    <dd><%= @item[:timezone] %></dd>

    <dt>Role</dt>
    <dd>PMC <%= @item[:role] %></dd>

    <% if @item[:urls] && !@item[:urls].empty? %>
      <dt>Profiles</dt>
      <dd>
        <ul>
          <% @item[:urls].each do |url| %>
            <li><a href="<%= url %>" target="_blank" rel="noopener noreferrer"><%= url %></a></li>
          <% end %>
        </ul>
      </dd>
    <% end %>
  </dl>
</div>
