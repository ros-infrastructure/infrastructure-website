<div class="row-list__item">
  <div class="row-list__main">
    <span class="row-list__title row-list__title--mono"><%= @item[:name] %></span>
    <p class="row-list__owner">owner: <%= @item[:owner] %></p>
    <% if @item[:description] %>
      <p class="row-list__desc"><%= @item[:description] %></p>
    <% end %>
  </div>
  <a class="btn" href="<%= @item[:url] %>" target="_blank" rel="noopener noreferrer">[ View repository ]</a>
</div>
