<div class="manifest-item">
  <div class="manifest-main">
    <a class="manifest-name" href="<%= @item[:url] %>"><%= @item[:name] %></a>
    <span class="manifest-owner">owner: <%= @item[:owner] %></span>
    <% if @item[:description] %>
      <p class="manifest-desc"><%= @item[:description] %></p>
    <% end %>
  </div>
  <a href="<%= @item[:url] %>" class="btn-bracket">View repository</a>
</div>
