<div class="project-hero">
  <span class="section-label">Project</span>
  <h1 class="page-title"><%= @item[:title] %></h1>
  <img src="<%= @config[:base_url] %>/images/<%= @item[:logo] %>" alt="<%= @item[:title] %> logo">
</div>
<div class="project-body">
  <%= yield %>
  <% if @item[:docs_url] %>
    <a href="<%= @item[:docs_url] %>" class="btn-bracket btn-bracket--primary">View documentation</a>
  <% end %>
</div>
