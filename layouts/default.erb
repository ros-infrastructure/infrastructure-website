<!DOCTYPE HTML>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= @item[:title] || @item[:name] %> &mdash; OSRA Infrastructure</title>
    <link rel="icon" type="image/x-icon" href="<%= @config[:base_url] %>/images/favicon.ico">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="<%= @config[:base_url] %>/stylesheet.css">

    <!-- you don't need to keep this, but it's cool for stats! -->
    <meta name="generator" content="Nanoc <%= Nanoc::VERSION %>">
  </head>
  <body>
    <nav class="site-nav">
      <div class="container site-nav__inner">
        <a class="brand" href="<%= @config[:base_url] %>/">
          <img class="brand__logo" src="<%= @config[:base_url] %>/images/ros-infrastructure.jpg" width="32" height="32" alt="">
          <span><span class="brand__name">OSRA</span><span class="brand__suffix">/infrastructure</span></span>
        </a>

        <input class="nav-toggle" type="checkbox" id="nav-toggle">
        <label class="nav-toggle__btn" for="nav-toggle" aria-label="Toggle navigation">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M3 5h14M3 10h14M3 15h14"/>
          </svg>
        </label>

        <div class="site-nav__links">
          <% nav_items.each do |label, path| %>
            <a class="site-nav__link<%= ' is-active' if nav_active?(@item, path) %>" href="<%= nav_url(path, @config[:base_url]) %>"<%= ' target="_blank" rel="noopener noreferrer"' if nav_external?(path) %>><%= label %><% if nav_external?(path) %><span class="site-nav__ext" aria-hidden="true">↗</span><% end %></a>
          <% end %>
          <a class="status-pill" href="https://status.openrobotics.org" target="_blank" rel="noopener noreferrer">
            <span class="status-pill__dot"></span>status.openrobotics.org
          </a>
        </div>
      </div>
    </nav>

    <main class="site-main<%= ' site-main--hero' if @item.identifier == '/index.md' %>">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <span>&copy; 2025 Open Robotics &mdash; Infrastructure Project</span>
        <div class="site-footer__links">
          <% nav_items.each do |label, path| %>
            <a href="<%= nav_url(path, @config[:base_url]) %>"<%= ' target="_blank" rel="noopener noreferrer"' if nav_external?(path) %>><%= label %></a>
          <% end %>
          <a href="https://osralliance.org" target="_blank" rel="noopener noreferrer">osralliance.org</a>
        </div>
      </div>
    </footer>
  </body>
</html>
