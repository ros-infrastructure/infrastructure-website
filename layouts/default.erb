<!DOCTYPE HTML>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= @item[:title] %></title>
    <link rel="icon" type="image/x-icon" href="<%= @config[:base_url] %>/images/favicon.ico">

    <!-- Type -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Default styles -->
    <link rel="stylesheet" href="<%= @config[:base_url] %>/stylesheet.css">

    <!-- you don't need to keep this, but it's cool for stats! -->
    <meta name="generator" content="Nanoc <%= Nanoc::VERSION %>">
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-bar">
        <a class="brand" href="<%= @config[:base_url] %>/">
          <img class="brand-mark" src="<%= @config[:base_url] %>/images/ros-infrastructure.jpg" alt="Infrastructure logo">
          <span class="brand-word">OSRA<span class="dim">/infrastructure</span></span>
        </a>
        <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-links" onclick="
          var l=document.getElementById('nav-links');
          var open=l.classList.toggle('is-open');
          this.setAttribute('aria-expanded', open);
        ">
          <span></span>
        </button>
        <nav class="nav-links" id="nav-links">
          <a class="nav-link" href="<%= @config[:base_url] %>/projects">Projects</a>
          <a class="nav-link" href="<%= @config[:base_url] %>/team">Team</a>
          <a class="nav-link" href="<%= @config[:base_url] %>/documentation">Documentation</a>
          <a class="nav-link" href="<%= @config[:base_url] %>/repos">Repositories</a>
          <a class="nav-link" href="<%= @config[:base_url] %>/#how-to-contribute">Contribute</a>
          <a class="status-pill" href="https://status.openrobotics.org" target="_blank" rel="noopener noreferrer">
            <span class="status-dot"></span> status.openrobotics.org
          </a>
        </nav>
      </div>
    </header>

    <main class="container" style="padding: 3rem 1.5rem 4rem;">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container footer-row">
        <p class="footer-copy">&copy; 2025 Open Robotics — Infrastructure Project</p>
        <nav class="footer-links">
          <a href="<%= @config[:base_url] %>/projects">Projects</a>
          <a href="<%= @config[:base_url] %>/team">Team</a>
          <a href="<%= @config[:base_url] %>/documentation">Documentation</a>
          <a href="<%= @config[:base_url] %>/repos">Repositories</a>
          <a href="https://osralliance.org" target="_blank" rel="noopener noreferrer">osralliance.org</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
